# Valores de EJEMPLO solo para correr en local con docker compose.
# Copie este archivo a .env (que no se versiona) y cámbielos si quiere.

# Contraseña del PostgreSQL del contenedor (no se publica fuera de Docker).
POSTGRES_PASSWORD=postgres-local-dev

# Clave para firmar los JWT: 32 bytes o más. Genere una con: openssl rand -base64 48
JWT_SIGNING_KEY=local-dev-signing-key-change-me-at-least-32-bytes

# Contraseña del operador de prueba "portero" que se siembra al arrancar.
OPERATOR_PASSWORD=Portero-Local-2026
